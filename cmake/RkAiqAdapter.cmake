# A port is supplied from the exact target BSP. This module never guesses vendor API signatures.
function(configure_rkaiq_adapter target)
    set(RKAIQ_ROOT "" CACHE PATH "Exact target BSP RkAiq SDK root")
    set(RKAIQ_INCLUDE_DIR "" CACHE PATH "Directory containing the actual RkAiq system header")
    set(RKAIQ_LIBRARY_DIR "" CACHE PATH "Directory containing matching target SDK libraries")
    set(RKAIQ_SYSTEM_HEADER "rk_aiq_user_api2_sysctl.h" CACHE STRING "System header actually supplied by the SDK")
    set(RKAIQ_LIBRARIES "" CACHE STRING "Absolute library paths from the SDK build, semicolon separated")
    set(RKAIQ_ADAPTER_SOURCE "" CACHE FILEPATH "Verified BSP source implementing isp::create_sdk_backend()")
    set(RKAIQ_EXTRA_INCLUDE_DIRS "" CACHE STRING "Additional include directories from the SDK build")
    if(NOT ENABLE_RKAIQ)
        message(STATUS "RKAIQ SDK adapter OFF: discovery and unavailable backends only")
        return()
    endif()
    if(NOT RKAIQ_INCLUDE_DIR)
        find_path(_rkaiq_include NAMES ${RKAIQ_SYSTEM_HEADER}
            HINTS ${RKAIQ_ROOT} ${RKAIQ_ROOT}/include
            PATH_SUFFIXES rkaiq uAPI2 include include/uAPI2)
        if(_rkaiq_include)
            set(RKAIQ_INCLUDE_DIR "${_rkaiq_include}" CACHE PATH "Actual SDK include directory" FORCE)
        endif()
    endif()
    if(NOT RKAIQ_INCLUDE_DIR OR NOT EXISTS "${RKAIQ_INCLUDE_DIR}/${RKAIQ_SYSTEM_HEADER}")
        message(FATAL_ERROR "RKAIQ_BACKEND_UNAVAILABLE: missing actual ${RKAIQ_SYSTEM_HEADER}; set RKAIQ_ROOT/RKAIQ_INCLUDE_DIR")
    endif()
    if(NOT RKAIQ_LIBRARIES)
        message(FATAL_ERROR "RKAIQ_BACKEND_UNAVAILABLE: set RKAIQ_LIBRARIES to the exact SDK build libraries (RKAIQ_LIBRARY_DIR=${RKAIQ_LIBRARY_DIR})")
    endif()
    string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _processor)
    if(NOT _processor MATCHES "^(aarch64|arm64|x86_64|amd64)$")
        message(FATAL_ERROR "RKAIQ SDK target architecture is unknown or unsupported: ${CMAKE_SYSTEM_PROCESSOR}; no ABI compatibility is inferred")
    endif()
    foreach(_lib IN LISTS RKAIQ_LIBRARIES)
        if(NOT IS_ABSOLUTE "${_lib}" OR NOT EXISTS "${_lib}" OR IS_DIRECTORY "${_lib}")
            message(FATAL_ERROR "RKAIQ SDK library must be an existing absolute file: ${_lib}")
        endif()
        file(READ "${_lib}" _header LIMIT 20 HEX)
        string(LENGTH "${_header}" _length)
        if(_length LESS 40)
            message(FATAL_ERROR "Invalid RKAIQ library header: ${_lib}")
        endif()
        string(SUBSTRING "${_header}" 0 8 _magic)
        if(_magic STREQUAL "7f454c46")
            string(SUBSTRING "${_header}" 8 2 _class)
            if(NOT _class STREQUAL "02")
                message(FATAL_ERROR "RKAIQ SDK architecture mismatch: expected 64-bit ELF class for ${CMAKE_SYSTEM_PROCESSOR}")
            endif()
            string(SUBSTRING "${_header}" 10 2 _endian)
            string(SUBSTRING "${_header}" 36 4 _machine)
            if(_endian STREQUAL "02")
                string(SUBSTRING "${_machine}" 0 2 _first)
                string(SUBSTRING "${_machine}" 2 2 _last)
                set(_machine "${_last}${_first}")
            elseif(NOT _endian STREQUAL "01")
                message(FATAL_ERROR "Unknown RKAIQ ELF byte order: ${_lib}")
            endif()
            if((_processor MATCHES "^(aarch64|arm64)$" AND NOT _machine STREQUAL "b700") OR
               (_processor MATCHES "^(x86_64|amd64)$" AND NOT _machine STREQUAL "3e00"))
                message(FATAL_ERROR "RKAIQ SDK architecture mismatch: target=${CMAKE_SYSTEM_PROCESSOR}, ELF e_machine=${_machine}, library=${_lib}")
            endif()
        else()
            message(FATAL_ERROR "RKAIQ SDK libraries require inspected ELF architecture; static archives/unknown formats are unsupported: ${_lib}")
        endif()
    endforeach()
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
        message(FATAL_ERROR "Actual RKAIQ adapter requires the matching Linux BSP toolchain, current target=${CMAKE_SYSTEM_NAME}")
    endif()
    if(NOT RKAIQ_ADAPTER_SOURCE OR NOT EXISTS "${RKAIQ_ADAPTER_SOURCE}")
        message(FATAL_ERROR "SDK found but no verified BSP API port: supply RKAIQ_ADAPTER_SOURCE implementing isp::create_sdk_backend(); vendor signatures are never guessed")
    endif()
    target_sources(${target} PRIVATE "${RKAIQ_ADAPTER_SOURCE}")
    target_compile_definitions(${target} PRIVATE RKAIQ_SDK_ADAPTER_ENABLED=1)
    target_include_directories(${target} PRIVATE "${RKAIQ_INCLUDE_DIR}" ${RKAIQ_EXTRA_INCLUDE_DIRS})
    target_link_libraries(${target} PUBLIC ${RKAIQ_LIBRARIES})
    # Link an actual backend factory. Static archives with no referenced symbols cannot establish ABI compatibility.
    add_executable(rkaiq_sdk_link_probe tools/rkaiq_sdk_link_probe.cpp)
    target_compile_definitions(rkaiq_sdk_link_probe PRIVATE RKAIQ_SYSTEM_HEADER="${RKAIQ_SYSTEM_HEADER}")
    target_include_directories(rkaiq_sdk_link_probe PRIVATE "${RKAIQ_INCLUDE_DIR}" ${RKAIQ_EXTRA_INCLUDE_DIRS})
    target_link_libraries(rkaiq_sdk_link_probe PRIVATE ${target})
    message(STATUS "RKAIQ SDK adapter configured; compile/link probe required. Runtime/hardware status remains NOT_MEASURED.")
endfunction()
